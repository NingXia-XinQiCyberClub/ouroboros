{
  "name": "ouroboros-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "go run ../cmd/desktop dev",
    "build": "vite build && go run ../cmd/desktop build-main",
    "build:desktop-main": "go run ../cmd/desktop build-main",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:contract": "go run ../cmd/desktop check-gui",
    "test:product-contract": "go run ../cmd/desktop check-product",
    "test:desktop-contract": "go run ../cmd/desktop check-desktop && go run ../cmd/desktop check-electron-runtime",
    "package:desktop:prepare": "go run ../cmd/desktop package",
    "package:desktop:dry-run": "go run ../cmd/desktop package --dry-run",
    "package:desktop:dir": "go run ../cmd/desktop package --dir",
    "package:desktop:dir:dry-run": "go run ../cmd/desktop package --dir --dry-run",
    "package:desktop:install": "go run ../cmd/desktop install",
    "package:desktop:install:dry-run": "go run ../cmd/desktop install --dry-run",
    "smoke:desktop-package:runtime": "go run ../cmd/desktop runtime-smoke",
    "smoke:desktop-package:runtime:quick": "go run ../cmd/desktop runtime-smoke quick",
    "smoke:desktop-package:runtime:diagnostics": "go run ../cmd/desktop runtime-smoke diagnostics",
    "smoke:desktop-package:runtime:ai-lite": "go run ../cmd/desktop runtime-smoke ai-lite",
    "electron": "go run ../cmd/desktop dev",
    "start": "go run ../cmd/desktop dev"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.3",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "electron": "^33.4.11",
    "lucide-react": "^0.468.0",
    "postcss": "^8.5.16",
    "react": "^18.3.1",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^9.0.10",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.63.0"
  }
}
